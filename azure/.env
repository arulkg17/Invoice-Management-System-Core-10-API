# Copy this file to ".env" (same folder) before running "docker compose up -d".
#
# ACCEPT_EULA: the Service Bus emulator and SQL Server are licensed software.
# Read the terms (links on the Microsoft docs page for the emulator) and change N to Y to accept them.
ACCEPT_EULA=Y

# SQL Server password for the emulator's metadata database (needs upper, lower, digit, symbol; 8+ chars)
MSSQL_SA_PASSWORD=123456